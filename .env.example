# Copier vers .env et adapter. Tous les paramètres sont optionnels.

# Dossiers surveillés pour les captures d'images (séparateur « ; »).
# Défaut : dossier de captures d'écran détecté via le registre Windows
# (ex. C:\Users\moi\OneDrive\Pictures\Captures d'écran) ; sinon ./data/watched
# SB_WATCH_DIRS=C:\Users\moi\Downloads

# Token d'auth pour l'endpoint /ingest/bookmark. Vide (défaut) = pas d'auth,
# suffisant puisque tout tourne en local.
# SB_INGEST_TOKEN=

# Écoute (local uniquement)
# SB_HOST=127.0.0.1
# SB_PORT=8420

# --- IA via OpenRouter (https://openrouter.ai/keys) ---
# Sans clé : la capture et le tri fonctionnent, mais sans embeddings
# (donc pas de suggestions de lien ni d'ancrage sémantique).
SB_OPENROUTER_API_KEY=sk-or-v1-...

# Un modèle par tâche — change librement, la liste est sur openrouter.ai/models
# Embeddings (utilisé à chaque capture : choisir un modèle pas cher) :
# SB_EMBED_MODEL=openai/text-embedding-3-small        # ou qwen/qwen3-embedding-0.6b
# Vision (description des photos sans texte — désactivé par défaut, coût/photo) :
# SB_VISION_MODEL=google/gemini-2.5-flash
# Modèle texte générique (réservé pour usage futur) :
# SB_TEXT_MODEL=google/gemini-2.5-flash

# OCR
# SB_OCR_LANG=fra+eng
# SB_OCR_MIN_CHARS=20

# Rituel
# SB_SESSION_MAX_ITEMS=15
# SB_SUGGEST_THRESHOLD=       # vide = suggestions désactivées (défaut v0.1) ;
                              # à fixer après calibrage sur suggestion_log, ex. 0.45